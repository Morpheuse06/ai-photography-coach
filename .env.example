# Copy this file to .env to use a real provider.
# Keep MODEL_PROVIDER=mock for local development without API charges.
MODEL_PROVIDER=mock
# DashScope example: qwen3.7-plus
MODEL_NAME=qwen3.7-plus
# Use the exact regional/workspace Base URL shown in the Model Studio console.
MODEL_BASE_URL=
MODEL_TIMEOUT_SECONDS=45
MODEL_MAX_RETRIES=2
LOG_LEVEL=INFO

# Never commit the copied .env file or a real API key.
MODEL_API_KEY=
