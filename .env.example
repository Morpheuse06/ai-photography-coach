# Copy this file to .env to use a real provider.
# Keep MODEL_PROVIDER=mock for local development without API charges.
MODEL_PROVIDER=mock
# DashScope example: qwen3.7-plus
MODEL_NAME=qwen3.7-plus
# Use the exact regional/workspace Base URL shown in the Model Studio console.
MODEL_BASE_URL=
MODEL_TIMEOUT_SECONDS=120
MODEL_MAX_RETRIES=2
LOG_LEVEL=INFO

# V2 uses the RAG pipeline. The mock provider keeps it local and free.
RAG_ENABLED=true
# Empty means: reuse MODEL_NAME for photo observation and retrieval planning.
RAG_PLANNER_MODEL=
RAG_CONTEXT_TIMEOUT_SECONDS=120
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_DIMENSIONS=1024
EMBEDDING_MAX_BATCH_SIZE=20
RERANK_MODEL=qwen3-rerank
# Exact workspace/region URL ending in /compatible-api/v1.
RERANK_BASE_URL=
RERANK_CANDIDATE_K=8
RERANK_FINAL_MAX_CHUNKS=6
CHROMA_PATH=data/chroma
KNOWLEDGE_CORPUS_PATH=knowledge/chunks/ai-photography-coach-handbook.json

# Never commit the copied .env file or a real API key.
MODEL_API_KEY=

# Control plane: quotas, analysis records, anonymous feedback, and the admin
# console. Disabled by default; enable to require the new headers and routes.
CONTROL_PLANE_ENABLED=false
DATABASE_URL=sqlite+aiosqlite:///data/control_plane.db
ADMIN_SESSION_TTL_HOURS=12
RESERVATION_TTL_MINUTES=30
# How long a concurrent retry waits for the original in-flight analysis.
IN_FLIGHT_WAIT_SECONDS=300
DEFAULT_ACCESS_MODE=open
DEFAULT_PER_SOURCE_HOUR_LIMIT=60
DEFAULT_GLOBAL_DAILY_LIMIT=500
DEFAULT_CONCURRENT_ANALYSIS_LIMIT=4
RETENTION_INTERVAL_HOURS=24
