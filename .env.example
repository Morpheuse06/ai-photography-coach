# Copy this file to .env to use a real provider.
# Keep MODEL_PROVIDER=mock for local development without API charges.
MODEL_PROVIDER=mock
# DashScope example: qwen3.7-plus
MODEL_NAME=qwen3.7-plus
# Use the exact regional/workspace Base URL shown in the Model Studio console.
MODEL_BASE_URL=
MODEL_TIMEOUT_SECONDS=45
MODEL_MAX_RETRIES=2
LOG_LEVEL=INFO

# RAG stays off until the knowledge and embedding path is explicitly enabled.
RAG_ENABLED=false
# Empty means: reuse MODEL_NAME for photo observation and retrieval planning.
RAG_PLANNER_MODEL=
RAG_CONTEXT_TIMEOUT_SECONDS=90
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_DIMENSIONS=1024
EMBEDDING_MAX_BATCH_SIZE=20
RERANK_MODEL=qwen3-rerank
# Exact workspace/region URL ending in /compatible-api/v1.
RERANK_BASE_URL=
RERANK_CANDIDATE_K=8
RERANK_FINAL_MAX_CHUNKS=6
CHROMA_PATH=data/chroma
KNOWLEDGE_CORPUS_PATH=knowledge/chunks/ai-photography-coach-handbook.json

# Never commit the copied .env file or a real API key.
MODEL_API_KEY=
