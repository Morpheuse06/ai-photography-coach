# Copy this file to .env to use a real Responses-compatible provider.
# Keep MODEL_PROVIDER=mock for local development without API charges.
MODEL_PROVIDER=mock
MODEL_NAME=gpt-5.6-terra
MODEL_BASE_URL=
MODEL_TIMEOUT_SECONDS=45
MODEL_MAX_RETRIES=2
LOG_LEVEL=INFO

# Never commit the copied .env file or a real API key.
MODEL_API_KEY=
